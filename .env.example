# Public URL of the site (canonical links, sitemap, Open Graph).
SITE_URL=https://proofcore.com

# NestJS API (server-to-server only, never exposed to the browser).
API_URL=http://127.0.0.1:4000
# Must match INTERNAL_API_KEY in proofcore-api. Generate with: openssl rand -base64 48
API_INTERNAL_KEY=

# Cloudflare Turnstile site key (public). Read at build time for the CSP.
TURNSTILE_SITE_KEY=

# Only if a proxy/CDN forwards a different host than the one in the browser.
SERVER_ACTIONS_ALLOWED_ORIGINS=

# Stable key when running more than one instance. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Company data. Anything left empty is simply not shown on the site.
COMPANY_LEGAL_NAME=
COMPANY_RNC=
COMPANY_ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=
BUSINESS_HOURS=
SECURITY_EMAIL=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
